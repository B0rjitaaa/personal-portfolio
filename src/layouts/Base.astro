---
import '../styles/global.css';
import { languages, withBase, site } from '../data/site.js';

const { t } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = Object.entries(languages).map(([code, l]) => ({
  code,
  href: new URL(withBase(l.path), Astro.site).toString(),
}));
const xDefault = new URL(withBase(languages.en.path), Astro.site).toString();
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase(site.photo), Astro.site).toString()} />
    <meta property="og:locale" content={t.lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#08090C" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='g' x1='0' x2='1'><stop stop-color='%2322D3EE'/><stop offset='1' stop-color='%238B5CF6'/></linearGradient></defs><rect width='100' height='100' rx='22' fill='%2308090C'/><text x='50' y='50' dy='.35em' text-anchor='middle' font-family='Helvetica,Arial,sans-serif' font-weight='700' font-size='44' fill='url(%23g)'>BM</text></svg>"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
