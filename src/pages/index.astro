---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile, about, experience, projects, stack } from '../data/cv.js';

const year = new Date().getFullYear();
---

<Base>
  <nav class="nav">
    <div class="wrap nav-inner">
      <a class="nav-brand" href="/">{profile.shortName}</a>
      <div class="nav-links">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#stack">Stack</a>
        <a href="#contacto">Contacto</a>
      </div>
    </div>
  </nav>

  <main>
    <header class="wrap hero">
      <span class="badge">{profile.availability}</span>
      <h1>{profile.name}</h1>
      <p class="hero-role">{profile.role} · {profile.location}</p>
      <p class="hero-tagline">{profile.tagline}</p>
      <div class="hero-links">
        {
          profile.links.map((l) => (
            <a class="btn" href={l.url} rel="noopener" target="_blank">
              <Icon name={l.icon} />
              {l.label}
            </a>
          ))
        }
      </div>
    </header>

    <div class="wrap">
      <section id="sobre-mi">
        <h2>Sobre mí</h2>
        <div class="prose">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section id="experiencia">
        <h2>Experiencia</h2>
        {
          experience.map((job) => (
            <article class="item">
              <div class="item-head">
                <div class="item-role">
                  {job.role} <span class="item-company">· {job.company}</span>
                </div>
                <div class="item-meta">{job.period}</div>
              </div>
              <ul>
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              <div class="tags">
                {job.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </article>
          ))
        }
      </section>

      <section id="proyectos">
        <h2>Proyectos</h2>
        <div class="cards">
          {
            projects.map((p) => (
              <article class="card">
                <h3>
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener">
                      {p.name} ↗
                    </a>
                  ) : (
                    p.name
                  )}
                </h3>
                <p>{p.description}</p>
                <div class="tags">
                  {p.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="stack">
        <h2>Stack</h2>
        {
          stack.map((g) => (
            <div class="stack-group">
              <span>{g.group}</span>
              <div class="tags" style="margin-top:0">
                {g.items.map((i) => (
                  <span class="tag">{i}</span>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <section id="contacto" class="contact">
        <h2>Contacto</h2>
        <p>
          ¿Tienes un proyecto en mente o quieres reforzar tu equipo? Escríbeme y te
          respondo en menos de 24 horas.
        </p>
        <div class="hero-links">
          <a class="btn" href={`mailto:${profile.email}`}>
            <Icon name="mail" />
            {profile.email}
          </a>
        </div>
      </section>
    </div>
  </main>

  <footer class="wrap">
    <span>© {year} {profile.name}</span>
    <span>Hecho con Astro · Publicado en GitHub Pages</span>
  </footer>
</Base>
