---
import SkillIcon from './SkillIcon.astro';
import { site, languages, withBase, heroVariant, showTalks } from '../data/site.js';

const { t } = Astro.props;
const lang = t.lang;

// Variantes del hero que traía el diseño original ('A' o 'B'), en site.js.
const heroA = heroVariant !== 'B';
const heroB = heroVariant === 'B';

// Estilos del conmutador de idioma (activo / inactivo).
const langOn =
  'background: #EDEFF4; color: #08090C; border: 0; padding: 6px 11px; font: inherit; letter-spacing: .08em;';
const langOff =
  'background: transparent; color: #8A90A0; border: 0; padding: 6px 11px; font: inherit; letter-spacing: .08em;';
---

<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background: #08090C; color: #EDEFF4; line-height: 1.55;">

  <header style="position: sticky; top: 0; z-index: 50; background: rgba(8,9,12,.86); backdrop-filter: blur(12px); border-bottom: 1px solid #23262E;">
    <nav style="max-width: 1180px; margin: 0 auto; padding: 14px clamp(20px, 5vw, 56px); display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
      <a href="#top" style="font-size: 15px; font-weight: 700; letter-spacing: -0.01em; color: #EDEFF4; white-space: nowrap;">Borja M. Merchán</a>
      <div style="display: flex; gap: clamp(14px, 2vw, 28px); flex: 1 1 320px; flex-wrap: wrap; font-size: 14.5px; color: #9298A8;">
        <a href="#experience" style="color: inherit;" class="hv1">{t.nav.experience}</a>
        <a href="#work" style="color: inherit;" class="hv2">{t.nav.work}</a>
        <a href="#skills" style="color: inherit;" class="hv3">{t.nav.skills}</a>
        <a href="#talks" style="color: inherit;" class="hv4">{t.nav.talks}</a>
        <a href="#contact" style="color: inherit;" class="hv5">{t.nav.contact}</a>
      </div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="display: flex; border: 1px solid #2A2E38; border-radius: 999px; overflow: hidden; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; letter-spacing: .08em;">
          <a href={withBase(languages.es.path)} hreflang="es" style={lang === 'es' ? langOn : langOff}>ES</a>
          <a href={withBase(languages.en.path)} hreflang="en" style={lang === 'en' ? langOn : langOff}>EN</a>
        </div>
        <a href="#contact" style="background: linear-gradient(90deg, #22D3EE, #8B5CF6); color: #08090C; padding: 9px 16px; border-radius: 999px; font-size: 14px; font-weight: 600; white-space: nowrap;" class="hv6">{t.nav.cta}</a>
      </div>
    </nav>
  </header>

  <section id="top" style="background: radial-gradient(120% 90% at 12% 0%, #10222B 0%, #0A0B10 46%, #0A0B10 60%), radial-gradient(90% 70% at 100% 8%, #171034 0%, rgba(10,11,16,0) 62%); color: #EDEFF4; padding: clamp(64px, 11vw, 140px) clamp(20px, 5vw, 56px) clamp(56px, 9vw, 112px); border-bottom: 1px solid rgba(255,255,255,.08);">
    {heroA && (
      <div style="max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: clamp(32px, 5vw, 72px); align-items: end;">
        <div>
          <p style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #7C6CF0; margin: 0 0 22px;">{t.hero.eyebrow}</p>
          <h1 style="font-size: clamp(2.5rem, 7.5vw, 5rem); line-height: 0.98; letter-spacing: -0.035em; font-weight: 700; margin: 0 0 24px; text-wrap: balance;">{t.hero.h1}</h1>
          <p style="font-size: clamp(1.15rem, 1.7vw, 1.4rem); color: #C9CCD6; max-width: 34ch; margin: 0 0 36px; text-wrap: pretty;">{t.hero.lede}</p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a href="#work" style="background: #7C6CF0; color: #fff; padding: 13px 24px; border-radius: 999px; font-size: 15px; font-weight: 600;" class="hv7">{t.hero.primary}</a>
            <a href="#contact" style="border: 1px solid rgba(255,255,255,.25); color: #EDEFF4; padding: 13px 24px; border-radius: 999px; font-size: 15px; font-weight: 600;" class="hv8">{t.hero.secondary}</a>
          </div>
        </div>
        <div style="position: relative; min-width: 0; align-self: stretch; min-height: 320px; overflow: hidden; mask: linear-gradient(180deg, transparent, #000 26%, #000 70%, transparent); -webkit-mask: linear-gradient(180deg, transparent, #000 26%, #000 70%, transparent); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 16px; line-height: 1; user-select: none;" aria-hidden="true">
        <div style="position: absolute; inset: 0; display: grid; grid-template-columns: repeat(6, 1fr); align-items: start;">
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; padding-top: 0px; animation: binFall 15s linear infinite; animation-delay: 0s; color: rgba(237,239,244,.72);"><span style="opacity: 0.27; color: inherit;">0</span><span style="opacity: 0.43; color: inherit;">0</span><span style="opacity: 0.28; color: inherit;">1</span><span style="opacity: 0.56; color: inherit;">0</span><span style="opacity: 0.62; color: inherit;">1</span><span style="opacity: 0.78; color: inherit;">0</span><span style="opacity: 0.76; color: inherit;">1</span><span style="opacity: 0.86; color: inherit;">1</span><span style="opacity: 0.40; color: #22D3EE;">0</span><span style="opacity: 0.88; color: inherit;">1</span><span style="opacity: 0.60; color: #22D3EE;">0</span><span style="opacity: 0.72; color: #22D3EE;">1</span><span style="opacity: 0.91; color: #22D3EE;">0</span><span style="opacity: 0.90; color: #22D3EE;">1</span><span style="opacity: 0.65; color: inherit;">1</span><span style="opacity: 0.27; color: inherit;">1</span><span style="opacity: 0.80; color: inherit;">1</span><span style="opacity: 0.83; color: #22D3EE;">0</span><span style="opacity: 0.60; color: inherit;">0</span><span style="opacity: 0.54; color: inherit;">1</span><span style="opacity: 0.83; color: inherit;">1</span><span style="opacity: 0.85; color: inherit;">1</span><span style="opacity: 0.69; color: inherit;">1</span><span style="opacity: 0.62; color: inherit;">1</span><span style="opacity: 0.84; color: inherit;">1</span><span style="opacity: 0.53; color: #22D3EE;">0</span><span style="opacity: 0.32; color: #22D3EE;">0</span><span style="opacity: 0.33; color: inherit;">0</span><span style="opacity: 0.28; color: inherit;">0</span><span style="opacity: 0.71; color: inherit;">1</span><span style="opacity: 0.30; color: inherit;">1</span><span style="opacity: 0.55; color: inherit;">1</span><span style="opacity: 0.60; color: #22D3EE;">1</span><span style="opacity: 0.27; color: inherit;">1</span></div>
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; padding-top: 26px; animation: binFall 18.5s linear infinite; animation-delay: -3.3s; color: rgba(237,239,244,.72);"><span style="opacity: 0.56; color: inherit;">0</span><span style="opacity: 0.46; color: inherit;">1</span><span style="opacity: 0.54; color: inherit;">0</span><span style="opacity: 0.40; color: inherit;">0</span><span style="opacity: 0.48; color: inherit;">1</span><span style="opacity: 0.25; color: inherit;">0</span><span style="opacity: 0.42; color: inherit;">0</span><span style="opacity: 0.57; color: inherit;">1</span><span style="opacity: 0.28; color: inherit;">1</span><span style="opacity: 0.45; color: inherit;">0</span><span style="opacity: 0.71; color: inherit;">0</span><span style="opacity: 0.46; color: inherit;">0</span><span style="opacity: 0.33; color: inherit;">0</span><span style="opacity: 0.40; color: inherit;">1</span><span style="opacity: 0.54; color: inherit;">1</span><span style="opacity: 0.77; color: inherit;">0</span><span style="opacity: 0.44; color: inherit;">0</span><span style="opacity: 0.50; color: inherit;">0</span><span style="opacity: 0.73; color: inherit;">1</span><span style="opacity: 0.90; color: #22D3EE;">0</span><span style="opacity: 0.29; color: inherit;">1</span><span style="opacity: 0.51; color: inherit;">1</span><span style="opacity: 0.84; color: inherit;">1</span><span style="opacity: 0.25; color: inherit;">0</span><span style="opacity: 0.90; color: inherit;">1</span><span style="opacity: 0.76; color: #22D3EE;">0</span><span style="opacity: 0.87; color: #22D3EE;">1</span><span style="opacity: 0.75; color: inherit;">1</span><span style="opacity: 0.68; color: inherit;">1</span><span style="opacity: 0.50; color: #22D3EE;">0</span><span style="opacity: 0.27; color: inherit;">0</span><span style="opacity: 0.69; color: inherit;">1</span><span style="opacity: 0.60; color: #22D3EE;">1</span><span style="opacity: 0.30; color: inherit;">0</span></div>
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; padding-top: 52px; animation: binFall 22s linear infinite; animation-delay: -6.6s; color: rgba(237,239,244,.72);"><span style="opacity: 0.85; color: inherit;">0</span><span style="opacity: 0.48; color: inherit;">0</span><span style="opacity: 0.25; color: inherit;">1</span><span style="opacity: 0.38; color: #22D3EE;">1</span><span style="opacity: 0.94; color: inherit;">0</span><span style="opacity: 0.33; color: inherit;">1</span><span style="opacity: 0.46; color: #22D3EE;">0</span><span style="opacity: 0.56; color: inherit;">0</span><span style="opacity: 0.49; color: inherit;">0</span><span style="opacity: 0.67; color: #22D3EE;">0</span><span style="opacity: 0.90; color: inherit;">0</span><span style="opacity: 0.69; color: inherit;">1</span><span style="opacity: 0.56; color: inherit;">0</span><span style="opacity: 0.83; color: inherit;">0</span><span style="opacity: 0.85; color: inherit;">1</span><span style="opacity: 0.47; color: inherit;">1</span><span style="opacity: 0.38; color: inherit;">1</span><span style="opacity: 0.62; color: inherit;">0</span><span style="opacity: 0.47; color: inherit;">1</span><span style="opacity: 0.39; color: inherit;">0</span><span style="opacity: 0.78; color: inherit;">0</span><span style="opacity: 0.60; color: inherit;">0</span><span style="opacity: 0.75; color: inherit;">1</span><span style="opacity: 0.83; color: inherit;">1</span><span style="opacity: 0.52; color: inherit;">1</span><span style="opacity: 0.68; color: inherit;">1</span><span style="opacity: 0.39; color: #22D3EE;">0</span><span style="opacity: 0.55; color: inherit;">0</span><span style="opacity: 0.92; color: inherit;">1</span><span style="opacity: 0.47; color: #22D3EE;">1</span><span style="opacity: 0.37; color: inherit;">0</span><span style="opacity: 0.47; color: #22D3EE;">1</span><span style="opacity: 0.57; color: inherit;">1</span><span style="opacity: 0.91; color: inherit;">1</span></div>
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; padding-top: 0px; animation: binFall 25.5s linear infinite; animation-delay: -9.9s; color: rgba(237,239,244,.72);"><span style="opacity: 0.44; color: inherit;">0</span><span style="opacity: 0.39; color: inherit;">1</span><span style="opacity: 0.50; color: inherit;">0</span><span style="opacity: 0.84; color: inherit;">0</span><span style="opacity: 0.86; color: inherit;">0</span><span style="opacity: 0.68; color: #22D3EE;">0</span><span style="opacity: 0.42; color: inherit;">0</span><span style="opacity: 0.76; color: inherit;">1</span><span style="opacity: 0.57; color: inherit;">0</span><span style="opacity: 0.38; color: #22D3EE;">1</span><span style="opacity: 0.64; color: inherit;">0</span><span style="opacity: 0.38; color: inherit;">0</span><span style="opacity: 0.32; color: inherit;">0</span><span style="opacity: 0.86; color: inherit;">0</span><span style="opacity: 0.25; color: inherit;">0</span><span style="opacity: 0.32; color: inherit;">0</span><span style="opacity: 0.29; color: inherit;">1</span><span style="opacity: 0.83; color: inherit;">0</span><span style="opacity: 0.43; color: inherit;">1</span><span style="opacity: 0.37; color: #22D3EE;">0</span><span style="opacity: 0.67; color: inherit;">1</span><span style="opacity: 0.76; color: inherit;">1</span><span style="opacity: 0.55; color: #22D3EE;">1</span><span style="opacity: 0.84; color: inherit;">1</span><span style="opacity: 0.46; color: inherit;">1</span><span style="opacity: 0.77; color: inherit;">1</span><span style="opacity: 0.51; color: inherit;">1</span><span style="opacity: 0.38; color: inherit;">1</span><span style="opacity: 0.66; color: inherit;">0</span><span style="opacity: 0.43; color: #22D3EE;">1</span><span style="opacity: 0.52; color: #22D3EE;">0</span><span style="opacity: 0.30; color: inherit;">0</span><span style="opacity: 0.83; color: inherit;">0</span><span style="opacity: 0.40; color: inherit;">0</span></div>
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; padding-top: 26px; animation: binFall 29s linear infinite; animation-delay: -13.2s; color: rgba(237,239,244,.72);"><span style="opacity: 0.72; color: inherit;">0</span><span style="opacity: 0.42; color: inherit;">0</span><span style="opacity: 0.79; color: inherit;">0</span><span style="opacity: 0.89; color: inherit;">0</span><span style="opacity: 0.48; color: inherit;">0</span><span style="opacity: 0.55; color: inherit;">0</span><span style="opacity: 0.28; color: #22D3EE;">1</span><span style="opacity: 0.55; color: inherit;">0</span><span style="opacity: 0.68; color: inherit;">0</span><span style="opacity: 0.81; color: #22D3EE;">0</span><span style="opacity: 0.45; color: inherit;">1</span><span style="opacity: 0.28; color: #22D3EE;">1</span><span style="opacity: 0.55; color: #22D3EE;">1</span><span style="opacity: 0.88; color: inherit;">1</span><span style="opacity: 0.61; color: inherit;">1</span><span style="opacity: 0.88; color: #22D3EE;">0</span><span style="opacity: 0.72; color: #22D3EE;">1</span><span style="opacity: 0.85; color: inherit;">1</span><span style="opacity: 0.90; color: #22D3EE;">1</span><span style="opacity: 0.59; color: #22D3EE;">1</span><span style="opacity: 0.89; color: inherit;">0</span><span style="opacity: 0.90; color: inherit;">1</span><span style="opacity: 0.30; color: inherit;">0</span><span style="opacity: 0.87; color: inherit;">0</span><span style="opacity: 0.42; color: inherit;">1</span><span style="opacity: 0.71; color: inherit;">0</span><span style="opacity: 0.39; color: inherit;">0</span><span style="opacity: 0.76; color: inherit;">0</span><span style="opacity: 0.83; color: inherit;">0</span><span style="opacity: 0.50; color: inherit;">1</span><span style="opacity: 0.68; color: inherit;">0</span><span style="opacity: 0.79; color: inherit;">0</span><span style="opacity: 0.28; color: inherit;">1</span><span style="opacity: 0.49; color: inherit;">0</span></div>
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: center; padding-top: 52px; animation: binFall 15s linear infinite; animation-delay: -16.5s; color: rgba(237,239,244,.72);"><span style="opacity: 0.31; color: inherit;">0</span><span style="opacity: 0.44; color: inherit;">1</span><span style="opacity: 0.47; color: inherit;">0</span><span style="opacity: 0.84; color: #22D3EE;">0</span><span style="opacity: 0.53; color: inherit;">0</span><span style="opacity: 0.42; color: inherit;">1</span><span style="opacity: 0.74; color: inherit;">0</span><span style="opacity: 0.85; color: inherit;">1</span><span style="opacity: 0.83; color: inherit;">0</span><span style="opacity: 0.26; color: inherit;">1</span><span style="opacity: 0.48; color: inherit;">1</span><span style="opacity: 0.91; color: inherit;">1</span><span style="opacity: 0.32; color: inherit;">0</span><span style="opacity: 0.43; color: inherit;">1</span><span style="opacity: 0.28; color: inherit;">1</span><span style="opacity: 0.36; color: inherit;">0</span><span style="opacity: 0.59; color: #22D3EE;">0</span><span style="opacity: 0.27; color: #22D3EE;">1</span><span style="opacity: 0.78; color: inherit;">0</span><span style="opacity: 0.28; color: inherit;">1</span><span style="opacity: 0.92; color: #22D3EE;">1</span><span style="opacity: 0.93; color: inherit;">0</span><span style="opacity: 0.93; color: inherit;">0</span><span style="opacity: 0.92; color: inherit;">0</span><span style="opacity: 0.84; color: inherit;">1</span><span style="opacity: 0.59; color: inherit;">0</span><span style="opacity: 0.86; color: inherit;">0</span><span style="opacity: 0.85; color: inherit;">1</span><span style="opacity: 0.44; color: inherit;">0</span><span style="opacity: 0.51; color: inherit;">1</span><span style="opacity: 0.91; color: inherit;">0</span><span style="opacity: 0.60; color: inherit;">1</span><span style="opacity: 0.82; color: inherit;">0</span><span style="opacity: 0.45; color: inherit;">1</span></div>
        </div>
        <div style="position: absolute; inset: 0; background: radial-gradient(55% 45% at 50% 50%, #7C6CF026, transparent 72%);"></div>
        </div>
      </div>
    )}
    {heroB && (
      <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
        <p style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #7C6CF0; margin: 0 0 26px;">{t.hero.eyebrow}</p>
        <h1 style="font-size: clamp(2.4rem, 8.5vw, 6rem); line-height: 0.95; letter-spacing: -0.04em; font-weight: 700; margin: 0 0 28px; text-wrap: balance;">{t.hero.h1}</h1>
        <p style="font-size: clamp(1.15rem, 1.8vw, 1.45rem); color: #C9CCD6; max-width: 52ch; margin: 0 auto 40px; text-wrap: pretty;">{t.hero.lede}</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-bottom: 56px;">
          <a href="#work" style="background: #7C6CF0; color: #fff; padding: 13px 24px; border-radius: 999px; font-size: 15px; font-weight: 600;" class="hv9">{t.hero.primary}</a>
          <a href="#contact" style="border: 1px solid rgba(255,255,255,.25); color: #EDEFF4; padding: 13px 24px; border-radius: 999px; font-size: 15px; font-weight: 600;" class="hv10">{t.hero.secondary}</a>
        </div>
      </div>
    )}
  </section>


  <section id="experience" style="border-top: 1px solid #23262E;">
    <div style="max-width: 1180px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px);">
      <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.7rem); letter-spacing: -0.03em; margin: 0 0 8px; font-weight: 700;">{t.exp.h2}</h2>
      <p style="color: #9298A8; font-size: 16.5px; margin: 0 0 clamp(36px, 5vw, 64px);">{t.exp.sub}</p>
      <div style="display: grid; gap: clamp(28px, 4vw, 48px);">
        {t.exp.jobs.map((job) => (
          <article style="display: flex; flex-wrap: wrap; gap: clamp(20px, 3vw, 48px); padding-top: 28px; border-top: 1px solid #23262E;">
            <div style="flex: 1 1 240px; min-width: 0;">
              <h3 style="font-size: 1.25rem; letter-spacing: -0.015em; margin: 0 0 6px; font-weight: 700;">{job.role}</h3>
              <div style="font-size: 16.5px; color: #22D3EE; margin-bottom: 10px;">{job.company}</div>
              <div style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; letter-spacing: .06em; color: #767D8E;">{job.meta}</div>
            </div>
            <div style="flex: 2.4 1 460px; min-width: 0;">
              <p style="margin: 0 0 22px; color: #C6CAD6; font-size: 17.5px; max-width: 68ch; text-wrap: pretty;">{job.summary}</p>
              <div style="display: grid; gap: 22px;">
                {job.items.map((it) => (
                  <div>
                    <div style="font-size: 16px; font-weight: 700; margin-bottom: 8px; color: #EDEFF4;">{it.title}</div>
                    <ul style="margin: 0 0 10px; padding-left: 18px; display: grid; gap: 6px;">
                      {it.lines.map((l) => (
                        <li style="font-size: 16.5px; color: #9298A8; text-wrap: pretty;">{l.t}</li>
                      ))}
                    </ul>
                    <div style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: #767D8E; letter-spacing: .02em;">{it.tech}</div>
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="work" style="border-top: 1px solid #23262E;">
    <div style="max-width: 1180px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px);">
      <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.7rem); letter-spacing: -0.03em; margin: 0 0 8px; font-weight: 700;">{t.work.h2}</h2>
      <p style="color: #9298A8; font-size: 16.5px; margin: 0 0 clamp(32px, 4vw, 56px);">{t.work.sub}</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1px; background: #23262E; border: 1px solid #23262E;">
        {t.work.items.map((p) => (
          <article style="background: #0F1117; padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 12px;" class="hv11">
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 16px;">
              <h3 style="font-size: 1.2rem; margin: 0; letter-spacing: -0.015em; font-weight: 700;">{p.name}</h3>
              <span style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: #7C6CF0; white-space: nowrap;">{p.kind}</span>
            </div>
            <p style="margin: 0; font-size: 16.5px; color: #9298A8; flex: 1; text-wrap: pretty;">{p.desc}</p>
            <div style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: #767D8E; padding-top: 12px; border-top: 1px solid #23262E;">{p.tech}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section style="background: #0C0E13; color: #EDEFF4; padding: clamp(56px, 9vw, 120px) clamp(20px, 5vw, 56px);">
    <div style="max-width: 1180px; margin: 0 auto;">
      <h2 style="font-size: clamp(1.8rem, 4vw, 3.2rem); letter-spacing: -0.035em; line-height: 1.05; margin: 0 0 clamp(36px, 5vw, 64px); max-width: 24ch; font-weight: 700; text-wrap: balance;">{t.diff.h2}</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(24px, 3vw, 48px);">
        {t.diff.pillars.map((d) => (
          <div style="border-top: 1px solid rgba(255,255,255,.18); padding-top: 20px;">
            <div style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; letter-spacing: .12em; color: #7C6CF0; margin-bottom: 14px;">{d.n}</div>
            <h3 style="font-size: 1.25rem; margin: 0 0 10px; font-weight: 700; letter-spacing: -0.015em;">{d.title}</h3>
            <p style="margin: 0; color: #A9AEBC; font-size: 16.5px; text-wrap: pretty;">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="skills" style="border-bottom: 1px solid #23262E;">
    <div style="max-width: 1180px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px);">
      <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.7rem); letter-spacing: -0.03em; margin: 0 0 clamp(32px, 4vw, 56px); font-weight: 700;">{t.skills.h2}</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(20px, 3vw, 40px);">
        {t.skills.groups.map((g, gi) => (
          <div style="border-top: 1px solid #2E3340; padding-top: 16px;">
            <h3 style="font-size: 1.15rem; letter-spacing: -0.015em; color: #EDEFF4; margin: 0 0 12px; font-weight: 700;"><span style="display: inline-flex; vertical-align: -3px; margin-right: 10px; color: #7C6CF0;"><SkillIcon index={gi} /></span>{g.name}</h3>
            <p style="margin: 0; font-size: 17px; color: #9298A8; text-wrap: pretty;">{g.items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {showTalks && (
    <section id="talks">
      <div style="max-width: 1180px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px); display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 64px);">
        <div style="flex: 1 1 260px; min-width: 0;">
          <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.7rem); letter-spacing: -0.03em; margin: 0 0 12px; font-weight: 700;">{t.talks.h2}</h2>
          <p style="color: #9298A8; font-size: 16.5px; margin: 0; max-width: 32ch;">{t.talks.sub}</p>
        </div>
        <div style="flex: 2.4 1 460px; min-width: 0; display: grid; gap: 0;">
          {t.talks.items.map((k) => (
            <div style="padding: 16px 0; border-top: 1px solid #23262E; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px 24px; align-items: baseline;">
              <div style="font-size: 17.5px; color: #EDEFF4;">{k.title}</div>
              <div style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; color: #767D8E; letter-spacing: .04em;">{k.where}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="education" style="border-top: 1px solid #23262E;">
    <div style="max-width: 1180px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px); display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 64px);">
      <div style="flex: 1 1 260px; min-width: 0;">
        <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.7rem); letter-spacing: -0.03em; margin: 0 0 12px; font-weight: 700;">{t.edu.h2}</h2>
        <p style="color: #9298A8; font-size: 16.5px; margin: 0 0 28px;">{t.edu.langs}</p>
      </div>
      <div style="flex: 2.4 1 460px; min-width: 0;">
        {t.edu.items.map((e) => (
          <div style="padding: 16px 0; border-top: 1px solid #23262E; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 6px 24px; align-items: baseline;">
            <div style="font-size: 17.5px; color: #EDEFF4;">{e.title}</div>
            <div style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; color: #767D8E; letter-spacing: .04em;">{e.meta}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" style="background: radial-gradient(100% 90% at 88% 100%, #1A1140 0%, #0A0B10 55%), #0A0B10; color: #EDEFF4; padding: clamp(64px, 10vw, 140px) clamp(20px, 5vw, 56px);">
    <div style="max-width: 1180px; margin: 0 auto;">
      <div style="display: flex; align-items: center; gap: 18px; margin: 0 0 22px;">
        <img src={withBase(site.photo)} alt={site.name} width="84" height="84" style="width: 84px; height: 84px; max-width: 84px; flex: 0 0 84px; border-radius: 50%; object-fit: cover; filter: saturate(0.9);" />
        <p style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #7C6CF0; margin: 0;">{t.contact.eyebrow}</p>
      </div>
      <h2 style="font-size: clamp(2rem, 5.5vw, 4rem); letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 24px; max-width: 22ch; font-weight: 700; text-wrap: balance;">{t.contact.h2}</h2>
      <p style="font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: #A9AEBC; max-width: 48ch; margin: 0 0 40px; text-wrap: pretty;">{t.contact.body}</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: clamp(40px, 6vw, 72px);">
        <a href="mailto:bmcx12@gmail.com" style="background: #7C6CF0; color: #fff; padding: 14px 26px; border-radius: 999px; font-size: 16.5px; font-weight: 600;" class="hv12">{t.contact.mail}</a>
        <a href="https://linkedin.com/in/bmmerchan" target="_blank" rel="noopener" style="border: 1px solid rgba(255,255,255,.25); color: #EDEFF4; padding: 14px 26px; border-radius: 999px; font-size: 16.5px; font-weight: 600;" class="hv13">LinkedIn</a>
        <a href="https://github.com/B0rjitaaa" target="_blank" rel="noopener" style="border: 1px solid rgba(255,255,255,.25); color: #EDEFF4; padding: 14px 26px; border-radius: 999px; font-size: 16.5px; font-weight: 600;" class="hv14">GitHub</a>
      </div>
      <div style="display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.12); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; letter-spacing: .06em; color: #767D8E;">
        <span>BORJA MANUEL MERCHÁN — SEVILLA, ES</span>
        <span>{t.contact.foot}</span>
      </div>
    </div>
  </section>
</div>
