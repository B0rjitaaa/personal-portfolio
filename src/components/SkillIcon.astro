---
// Iconos de las familias del stack, portados del diseño original.
const { index = 0 } = Astro.props;

const SHAPES = {
  0: `<circle cx="5" cy="12" r="2" />
    <circle cx="12" cy="12" r="2" />
    <circle cx="19" cy="12" r="2" />`,
  1: `<polyline points="9 7 4 12 9 17" />
    <polyline points="15 7 20 12 15 17" />`,
  2: `<rect x="4" y="4" width="16" height="4" rx="1" />
    <rect x="4" y="10" width="16" height="4" rx="1" />
    <rect x="4" y="16" width="16" height="4" rx="1" />`,
  3: `<rect x="3" y="5" width="18" height="14" rx="2" />
    <line x1="3" y1="9.5" x2="21" y2="9.5" />`,
  4: `<polygon points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5" />`,
  5: `<ellipse cx="12" cy="6" rx="7" ry="3" />
    <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6" />`,
  6: `<rect x="9" y="3" width="6" height="6" rx="1" />
    <rect x="3" y="15" width="6" height="6" rx="1" />
    <rect x="15" y="15" width="6" height="6" rx="1" />
    <path d="M12 9v3M6 15v-1.5h12V15" />`,
  7: `<circle cx="12" cy="12" r="9" />
    <polyline points="8 12.5 11 15.5 16 9.5" />`,
};
const shape = SHAPES[index] ?? SHAPES[0];
---

<svg
  width="17"
  height="17"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={shape}
/>
